{
  "name": "nubila-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:cf": "DEPLOY_BASE=/ vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dest garden --repo git@github.com:nico-dela/nubila.git",
    "deploy:cf": "npm run build:cf && wrangler pages deploy dist --project-name=nubila-garden --commit-dirty=true"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^5.0.0",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.143.0"
  }
}
